# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# 環境変数のテンプレート。
# 実際に使用する際はこのファイルを .env にコピーして値を設定する。
#   cp .env.example .env
#
# 注意:
#   .env は .gitignore によりコミットされない。
#   パブリックリポジトリなので、シークレットは必ず .env 側にのみ置くこと。
# =============================================================================

# アプリケーションの動作環境。dev / test / prod
APP_ENV=dev

# デバッグモード（True にすると詳細なエラーログと自動リロードが有効になる）
DEBUG=True

# セッションの署名に使うシークレットキー
# 実運用では十分に長いランダムな文字列を設定すること
#   例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-please

# データベース接続文字列（SQLite）
# 相対パスで指定した場合、プロジェクトルートからの相対パスになる
DATABASE_URL=sqlite:///./data/attendance.db
